# Copiar a .env (`cp .env.example .env`). .env NO se versiona.
# Todos los valores de este archivo son de ejemplo para desarrollo: nunca poner secretos reales acá.

# --- Puertos publicados en el host (cambiar si alguno está ocupado) ---
FRONTEND_PORT=8080
BACKEND_PORT=8081
DB_PORT=5432
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- Base de datos ---
# En Compose, SPRING_DATASOURCE_URL/USERNAME/PASSWORD se arman solos desde estas variables.
POSTGRES_DB=turnos
POSTGRES_USER=turnos
POSTGRES_PASSWORD=cambiar-esto

# --- Backend: seguridad ---
# Cadena de 32 bytes o más. Cambiarla fuera de desarrollo.
JWT_SECRET=cambiar-por-una-cadena-larga-de-32-bytes-o-mas
JWT_EXPIRATION_MINUTES=480

# --- Backend: odontólogo inicial (datos ficticios, nunca nombre ni email reales) ---
# Este email recibe las alertas de turnos pendientes (en desarrollo llegan a Mailpit).
SEED_ODONTOLOGO_NOMBRE=Dr. Ejemplo
SEED_ODONTOLOGO_EMAIL=odontologo@ejemplo.com
SEED_ODONTOLOGO_PASSWORD=cambiar-esto

# --- Backend: reglas de negocio ---
APP_FRONTEND_BASE_URL=http://localhost:8080
APP_ZONA_HORARIA=America/Argentina/Buenos_Aires
APP_AGENDA_PASO_MINUTOS=15
APP_RECORDATORIO_INTERVALO_MIN=15
APP_RECORDATORIO_HORAS_ANTES=48
APP_ALERTA_PENDIENTE_HORAS=24
APP_CANCELACION_HORAS_MINIMAS=24
APP_TURNO_ANTICIPACION_MIN_HORAS=2
APP_TURNO_VENTANA_MAX_DIAS=60
APP_CONSULTORIO_CONTACTO=Tel. 11 5555-5555

# --- Mail ---
# Desarrollo: Mailpit (captura todo, no sale a internet). UI en http://localhost:8025
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
APP_MAIL_FROM=turnos@consultorio.local
# Demo con Gmail: cambiar solo estas variables (la contraseña es una "contraseña de aplicación"):
#   SPRING_MAIL_HOST=smtp.gmail.com
#   SPRING_MAIL_PORT=587
#   SPRING_MAIL_USERNAME=cuenta@gmail.com
#   SPRING_MAIL_PASSWORD=xxxx xxxx xxxx xxxx
#   SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
#   SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
#   APP_MAIL_FROM=cuenta@gmail.com
#   APP_FRONTEND_BASE_URL=<URL real desde la que se presenta>
